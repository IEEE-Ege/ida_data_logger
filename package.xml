<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ida_data_logger</name>
  <version>1.0.0</version>
  <description>
    Mavi İnci İDA — Veri kayıt paketi.
    Annotated video (MP4), telemetri CSV (GPS/hız/başlık @ 1 Hz)
    ve costmap ROS bag kaydı.
  </description>
  <maintainer email="ieeegesb@gmail.com">IEEE Ege Mavi İnci Yazılım Ekibi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rosbag2_py</depend>
  <depend>ida_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
